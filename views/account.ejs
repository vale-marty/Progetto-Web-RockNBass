<!DOCTYPE html>
<html lang="it">
<%- include('partials/head') %>
<body>
    <header>
        <%- include('partials/navbar') %>
    </header>

    <main class="container-fluid pt-5 mt-5 bg-dark min-vh-100">
        <div class="d-md-none p-3 border-bottom border-secondary bg-black">
            <button class="btn btn-outline-danger w-100 d-flex justify-content-between align-items-center" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar">
                <span><i class="bi bi-list me-2"></i>Menu Account</span>
                <i class="bi bi-chevron-down"></i>
            </button>
        </div>

        <div class="row">
            <nav id="sidebar" class="col-md-3 col-lg-2 d-md-block bg-black sidebar collapse border-end border-secondary shadow">
                <div class="position-sticky pt-3 h-100">
                    <div class="px-3 mb-4 text-center d-none d-md-block">
                        <i class="bi bi-person-circle text-danger fs-1"></i>
                        <h6 class="text-white mt-2 mb-0" id="userNameDisplay"></h6>
                        <small class="text-white-50" id="userRoleBadge">Ruolo</small>
                    </div>
                    
                    <ul class="nav flex-column gap-2 px-2" id="sidebarMenu">
                        </ul>

                    <hr class="text-secondary mx-3">
                    <div class="px-3 pb-5">
                        <button onclick="logout()" class="btn btn-outline-danger btn-sm w-100">
                            <i class="bi bi-box-arrow-right me-2"></i>Logout
                        </button>
                    </div>
                </div>
            </nav>

            <div class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                <div id="content-area" class="text-white">
                    <div id="welcome-screen" class="text-center py-5 mt-md-5">
                        <h1 class="display-4 fw-bold">Benvenuto nell'area <span class="text-danger">Rock N' Bass</span></h1>
                        <p class="text-white-50 fs-5">Seleziona una voce dal menu per iniziare a gestire il tuo profilo.</p>
                    </div>

                    <section id="section-catalogo" class="content-section d-none">
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
                            <h3 class="m-0">Gestione Inventario</h3>
                            <button class="btn btn-danger" onclick="apriEditorProdotto()">+ Aggiungi Strumento</button>
                        </div>
                        <div class="table-responsive bg-black p-2 p-md-3 rounded border border-secondary shadow-sm">
                            <table class="table table-dark table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Strumento</th>
                                        <th>Prezzo</th>
                                        <th>Stato</th>
                                        <th class="text-center">Azioni</th>
                                    </tr>
                                </thead>
                                <tbody id="admin-table-body"></tbody>
                            </table>
                        </div>
                    </section>

                    <section id="section-ordini" class="content-section d-none">
                        <h3 class="mb-4">Storico Acquisti</h3>
                        <div id="ordini-container">
                            </div>
                    </section>

                    <section id="section-noleggi" class="content-section d-none">
                        <h3 class="mb-4">Gestione Noleggi</h3>
                        <div id="noleggi-container">
                            </div>
                    </section>

                    <section id="section-contatti" class="content-section d-none">
                        <h3 class="mb-4">Richieste Form</h3>
                        <div id="richieste-container">
                            </div>
                    </section>
                </div>
            </div>
        </div>
    </main>


    <%- include('partials/footer') %>

    <script src="js/main.js"></script>
    <script src="js/account.js"></script>
    <!--script per modificare l'allert-->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script> 
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>