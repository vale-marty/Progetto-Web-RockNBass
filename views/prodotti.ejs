<!DOCTYPE html>
<html lang="it">
<%- include('partials/head') %>
<body class="d-flex flex-column min-vh-100 bg-dark">
    <header>
        <%- include('partials/navbar') %>
    </header>

    <main class="pt-5 mt-5 bg-dark flex-grow-1">

        <section class="text-center mb-2 titolo">
            <h2 class="display-5 fw-bold text-white mt-5">Il Nostro <span class="text-danger">Catalogo</span></h2>
            <div class="header-line mx-auto"></div>
        </section>

        <section class="search-filter-section py-5 bg-dark">
            <div class="container">
                <!-- Tab di Macro-Categoria -->
                <div class="row mb-5">
                    <div class="col-12 d-flex justify-content-center">
                        <div class="filter-container d-flex flex-wrap justify-content-center gap-2 shadow-lg" role="group">
                            <button type="button" class="btn btn-outline-danger active filter-tab" data-macro="all">Tutto</button>
                            <button type="button" class="btn btn-outline-danger filter-tab" data-macro="bassi">Bassi</button>
                            <button type="button" class="btn btn-outline-danger filter-tab" data-macro="amplificatori">Amplificatori</button>
                            <button type="button" class="btn btn-outline-danger filter-tab" data-macro="accessori">Accessori</button>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
    
                    <div class="col-md-10 order-1">
                        <label class="text-white-50 small mb-2">Cerca nome o keyword</label>
                        <div class="input-group">
                            <span class="input-group-text bg-black border-secondary text-danger"><i class="bi bi-search"></i></span>
                            <input type="text" id="searchInput" class="form-control bg-black border-secondary text-white" placeholder="Es: Vintage, 5 corde, Valve...">
                        </div>
                    </div>

                    <div class="col-md-2 order-last order-md-2 d-flex align-items-end mb-4 mb-md-0">
                        <button class="btn btn-reset w-100"  onclick="resetFiltri()">Reset</button>
                    </div>

                    <div class="col-md-4 order-3 mt-4">
                        <label class="text-white-50 small mb-2">Specifiche / Tag</label>
                        <select id="filterTag" class="form-select bg-black border-secondary text-white">
                            <option value="all">Tutte le caratteristiche</option>
                        </select>
                    </div>

                    <div class="col-md-4 order-4 mt-4">
                        <label class="text-white-50 small mb-2">Prezzo: <span class="text-danger fw-bold" id="PriceLabel">€10000</span></label>
                        <div class="d-flex align-items-center bg-black p-2 border border-secondary rounded" style="height: 47px;">
                            <span class="text-white-50 me-2 small">€0</span>
                            <input type="range" class="form-range" id="priceRange" min="0" max="10000" step="250" value="10000">
                            <span class="text-white-50 ms-2 small">€10000</span>
                        </div>
                    </div>

                    <div class="col-md-4 order-5 mt-4">
                        <label class="text-white-50 small mb-2">Noleggio Mensile: <span class="text-danger fw-bold" id="rentLabel">€500</span></label>
                        <div class="d-flex align-items-center bg-black p-2 border border-secondary rounded" style="height: 47px;">
                            <span class="text-white-50 me-2 small">€0</span>
                            <input type="range" class="form-range" id="rentRange" min="0" max="700" step="50" value="700">
                            <span class="text-white-50 ms-2 small">€700</span>
                        </div>
                        <div class="mt-1">
                            <small class="text-danger" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                <i class="bi bi-info-circle me-1"></i>IL NOLEGGIO È RISERVATO ESCLUSIVAMENTE ALLE SCUOLE
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="py-5 bg-black">
            <div class="container">
                <!-- Messaggio Risultati -->
                <div class="row mb-3">
                    <div class="col-12">
                        <p class="text-white-50">Prodotti trovati: <span id="productCount" class="text-white fw-bold">0</span></p>
                    </div>
                </div>

                <!-- Grid Unica dei Prodotti -->
                <div id="main-catalogo" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
                    <!-- Qui JavaScript inietterà TUTTE le card filtrate -->
                </div>

                <!-- Messaggio Nessun Risultato (Nascosto di default) -->
                <div id="noResults" class="text-center py-5 d-none">
                    <i class="bi bi-search text-secondary display-1"></i>
                    <h3 class="text-white mt-3">Nessun prodotto corrisponde ai filtri</h3>
                    <button class="btn btn-link text-danger" onclick="resetFiltri()">Resetta filtri</button>
                </div>
            </div>
        </section>
        
    
    </main>  

    <%- include('partials/footer') %>

    <script src="js/prodotti.js"></script>
    <script src="js/main.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>