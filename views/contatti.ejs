<!DOCTYPE html>
<html lang="it">
<%- include('partials/head') %>
<body class="d-flex flex-column min-vh-100 bg-dark">
    <header>
        <%- include('partials/navbar') %>
    </header>

    <main class="py-5 mt-5 bg-dark flex-grow-1">
        <div class="container py-5 px-4">
            <div class="row g-5">
                <div class="col-lg-5 text-white">
                    <h2 class="fw-bold mb-4">ROCK <span class="text-danger">N'</span> BASS</h2>
                    <p class="text-white-50 mb-5">Vieni a trovarci nel nostro negozio oppure scrivici per una consulenza personalizzata o una riparazione dei tuoi bassi.</p>
                    
                    <div class="d-flex mb-4">
                        <div class="icon-box me-3 text-danger fs-3"><i class="bi bi-geo-alt"></i></div>
                        <div>
                            <h5 class="mb-1">Indirizzo</h5>
                            <p class="text-white-50">Via delle Corde Intrecciate, 42 - Milano (MI)</p>
                        </div>
                    </div>

                    <div class="d-flex mb-4">
                        <div class="icon-box me-3 text-danger fs-3"><i class="bi bi-telephone"></i></div>
                        <div>
                            <h5 class="mb-1">Telefono</h5>
                            <p class="text-white-50">+39 02 123 4567</p>
                        </div>
                    </div>

                    <div class="d-flex mb-4">
                        <div class="icon-box me-3 text-danger fs-3"><i class="bi bi-envelope"></i></div>
                        <div>
                            <h5 class="mb-1">Email</h5>
                            <p class="text-white-50">info@rocknbass.it</p>
                        </div>
                    </div>

                    <div class="bg-light p-4 rounded border border-secondary mt-5">
                        <h5 class="text-danger mb-3">Orari di Apertura</h5>
                        <ul class="list-unstyled text-white mb-0">
                            <li class="d-flex justify-content-between"><span>Lun - Ven:</span> <span>10:00 - 19:30</span></li>
                            <li class="d-flex justify-content-between"><span>Sabato:</span> <span>10:00 - 13:00</span></li>
                            <li class="d-flex justify-content-between text-danger"><span>Domenica:</span> <span>Chiuso</span></li>
                        </ul>
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="card bg-light border-secondary p-4 p-md-5">
                        <form id="contactForm">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="text-white-50 small mb-2">Nome e Cognome</label>
                                    <input type="text" id="c-nome" class="form-control bg-dark border-secondary text-white" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-white-50 small mb-2">Numero di Telefono</label>
                                    <input type="text" id="c-telefono" class="form-control bg-dark border-secondary text-white" required>
                                </div>
                                <div class="col-md-12">
                                    <label class="text-white-50 small mb-2">Email</label>
                                    <input type="email" id="c-email" class="form-control bg-dark border-secondary text-white">
                                </div>
                                <div class="col-12">
                                    <label class="text-white-50 small mb-2">Motivo del contatto</label>
                                    <select id="c-motivo" class="form-select bg-dark border-secondary text-white" required>
                                        <option value="" selected disabled>Scegli un'opzione...</option>
                                        <option value="riparazione">Riparazione</option>
                                        <option value="setup">Set-up professionale</option>
                                        <option value="consulenza">Consulenza acquisto</option>
                                        <option value="info">Richiesta informazioni</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="text-white-50 small mb-2">Messaggio</label>
                                    <textarea id="c-messaggio" class="form-control bg-dark border-secondary text-white" rows="5" placeholder="Descrivi qui le tue necessità..."></textarea>
                                </div>
                                <div class="col-12 mt-4">
                                    <button type="submit" class="btn btn-danger w-100 py-3">INVIA MESSAGGIO</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main> 

    <%- include('partials/footer') %>

    <script src="js/main.js"></script>
    <script src="js/contatti.js"></script>
    <!--script per modificare l'allert-->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script> 
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>