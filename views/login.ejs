<!DOCTYPE html>
<html lang="it">
<%- include('partials/head') %>
<body>
    <header>
        <%- include('partials/navbar') %>
    </header>

    <main class="login-page d-flex align-items-center justify-content-center min-vh-100 bg-dark">
        <div class="login-card p-4 p-md-5 rounded shadow-lg bg-light">
            <div class="text-center mb-4">
                <img src="assets/images/logo/logo_completo.png" alt="Logo" width="80" class="mb-3">
                <h2 class="text-danger fw-bold">BENTORNATO </h2>
                <p class="text-white">Inserisci le tue credenziali per accedere</p>
            </div>

            <form id="loginForm">
                <div class="mb-3">
                    <label class="text-white-50 small mb-2">Username</label>
                    <input type="text" id="username" class="form-control bg-dark border-secondary text-white p-3" placeholder="username" required>
                </div>
                <div class="mb-4">
                    <label class="text-white-50 small mb-2">Password</label>
                    <input type="password" id="password" class="form-control bg-dark border-secondary text-white p-3" placeholder="••••••••" required>
                </div>
                
                <button type="submit" class="btn btn-danger w-100 py-3  mb-3">ACCEDI</button>
                
                <div class="text-center">
                    <a href="#" onclick="mostraRecupero()" class="text-white-50 small text-decoration-none">Password dimenticata?</a>
                    <hr class="border-secondary my-4">
                    <p class="text-white-50">Non hai un account? <a href="registrazione.html" class="text-danger fw-bold text-decoration-none">Registrati ora</a></p>
                </div>
            </form>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script src="js/login.js"></script>
    <script src="js/main.js"></script>
    <!--script per modificare l'allert del recupero password-->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script> 
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>